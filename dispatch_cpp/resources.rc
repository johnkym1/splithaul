#include <windows.h>
#include "app_version.h"
1 ICON "assets\\grumpyman.ico"
101 RCDATA "assets\\grumpyman.png"

1 VERSIONINFO
FILEVERSION DISPATCH_VERSION_NUMERIC
PRODUCTVERSION DISPATCH_VERSION_NUMERIC
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", SPLITHAUL_BRAND_TEXT
            VALUE "FileVersion", DISPATCH_VERSION_TEXT
            VALUE "ProductName", SPLITHAUL_BRAND_TEXT
            VALUE "CompanyName", DISPATCH_AUTHOR_TEXT
            VALUE "ProductVersion", DISPATCH_VERSION_TEXT " (development)"
            VALUE "OriginalFilename", "SplitHaul.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
